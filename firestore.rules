rules_version = '2';

// O perfil vem do token do login (custom claims gravados pelo script de usuários):
//   P/3    -> perfil = 'p3'
//   Cia    -> perfil = 'unidade' e unidade = '1cia' ... '6cia' | 'ft'
// Tudo que não estiver liberado aqui fica bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function ehP3() {
      return logado() && request.auth.token.perfil == 'p3';
    }

    function ehDaMinhaUnidade(dados) {
      return logado()
        && request.auth.token.perfil == 'unidade'
        && request.auth.token.unidade is string
        && dados.unidadeId == request.auth.token.unidade;
    }

    // A Cia só mexe nos campos da resposta, só nos status dela
    // e não altera encaminhamento já aceito ou cancelado pela P/3.
    // Para marcar "respondido" precisa da resposta e do nome de quem respondeu.
    function respostaDaUnidadeValida() {
      let novo = request.resource.data;
      return novo.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resposta', 'respondidoPor', 'respondidoEm', 'lidoEm', 'anexosResposta', 'atualizadoEm'])
        && !(resource.data.status in ['aceito', 'cancelado'])
        && novo.status in ['visualizado', 'em_andamento', 'respondido']
        && (novo.status != 'respondido'
          || (novo.resposta is string && novo.resposta.size() > 0
            && novo.respondidoPor is string && novo.respondidoPor.size() > 0));
    }

    match /demandas/{demandaId} {
      allow read, write: if ehP3();

      match /historico/{eventoId} {
        allow read, create: if ehP3();
      }
    }

    match /encaminhamentos/{encaminhamentoId} {
      allow read: if ehP3() || ehDaMinhaUnidade(resource.data);
      allow create, delete: if ehP3();
      allow update: if ehP3() || (ehDaMinhaUnidade(resource.data) && respostaDaUnidadeValida());
    }

    match /caixaEntrada/{itemId} {
      allow read, write: if ehP3();
    }

    match /contadores/{contadorId} {
      allow read, write: if ehP3();
    }
  }
}
