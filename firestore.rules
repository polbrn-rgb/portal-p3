rules_version = '2';

// O perfil vem do token do login (custom claims gravados pelo script de usuários):
//   P/3    -> perfil = 'p3'
//   Cia    -> perfil = 'unidade' e unidade = '1cia' ... '6cia' | 'ft'
//   Sala de Operações -> perfil = 'sala';  CFP -> perfil = 'cfp' (o CFP também usa a página da Sala)
// Logins individuais (por RE) levam ainda re e, no chefe/encarregado da P/3, admin = true (aba Administrador).
// Tudo que não estiver liberado aqui fica bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function ehP3() {
      return logado() && request.auth.token.perfil == 'p3';
    }

    // Conta do Administrador (senha própria, usada só na aba Administrador da P/3).
    function ehAdmin() {
      return logado() && (request.auth.token.perfil == 'admin'
        || (request.auth.token.perfil == 'p3' && request.auth.token.get('admin', false) == true));
    }

    // Página da Sala de Operações: a Sala e o CFP.
    function veSala() {
      return logado() && (request.auth.token.perfil == 'sala' || request.auth.token.perfil == 'cfp');
    }

    // O Administrador lê e grava tudo (zerar o portal, ajustar o contador do numerador).
    match /{documento=**} {
      allow read, write: if ehAdmin();
    }

    function ehPerfil(perfil) {
      return logado() && request.auth.token.perfil == perfil;
    }

    function ehDaMinhaUnidade(dados) {
      return logado()
        && request.auth.token.perfil == 'unidade'
        && request.auth.token.unidade is string
        && dados.unidadeId == request.auth.token.unidade;
    }

    // A Cia só mexe nos campos da resposta, só nos status dela
    // e não altera encaminhamento já aceito ou cancelado pela P/3.
    // Para marcar "respondido" precisa da resposta e do nome de quem respondeu.
    function respostaDaUnidadeValida() {
      let novo = request.resource.data;
      return novo.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resposta', 'respondidoPor', 'respondidoEm', 'lidoEm', 'anexosResposta', 'atualizadoEm'])
        && !(resource.data.status in ['aceito', 'cancelado'])
        && novo.status in ['visualizado', 'em_andamento', 'respondido']
        && (novo.status != 'respondido'
          || (novo.resposta is string && novo.resposta.size() > 0
            && novo.respondidoPor is string && novo.respondidoPor.size() > 0));
    }

    match /demandas/{demandaId} {
      allow read, write: if ehP3();

      match /historico/{eventoId} {
        allow read, create: if ehP3();
      }
    }

    match /encaminhamentos/{encaminhamentoId} {
      allow read: if ehP3() || ehDaMinhaUnidade(resource.data);
      // A observação da demanda é só da P/3: não pode ir para o encaminhamento da Cia.
      allow create: if ehP3() && !('observacao' in request.resource.data);
      allow delete: if ehP3();
      allow update: if ehP3() || (ehDaMinhaUnidade(resource.data) && respostaDaUnidadeValida());
    }

    // Checklist Operações (id = número da demanda). A Sala lê para lançar os resultados.
    match /operacoes/{numero} {
      allow read: if ehP3() || veSala();
      allow write: if ehP3();
    }

    // Resultados lançados pela Sala de Operações (id = numero_dia); o motor grava na planilha.
    function resultadoValido(id) {
      let r = request.resource.data;
      return r.keys().hasOnly(['numero', 'dia', 'protocoloResultado', 'valores', 'salvoPor', 'salvoEm', 'gravado'])
        && r.numero is string && r.dia is string && id == r.numero + '_' + r.dia
        && r.protocoloResultado is string && r.valores is map
        && r.salvoPor is string && r.salvoPor.size() > 0
        && r.gravado == false;
    }

    match /resultados/{id} {
      allow read: if ehP3() || veSala();
      allow create, update: if veSala() && resultadoValido(id);
    }

    // Solicitação de efetivo: a P/3 cria uma por Cia; a Cia só informa os policiais.
    function respostaEfetivoValida() {
      let novo = request.resource.data;
      return novo.diff(resource.data).affectedKeys()
          .hasOnly(['policiais', 'status', 'respondidoPor', 'respondidoEm', 'atualizadoEm'])
        && novo.status == 'respondida'
        && novo.policiais is list && novo.policiais.size() > 0
        && novo.respondidoPor is string && novo.respondidoPor.size() > 0;
    }

    match /solicitacoesEfetivo/{id} {
      allow read: if ehP3() || ehDaMinhaUnidade(resource.data);
      allow create, delete: if ehP3();
      allow update: if ehP3() || (ehDaMinhaUnidade(resource.data) && respostaEfetivoValida());
    }

    // Aperfeiçoamento → EAP: a P/3 abre; cada Cia responde a sua; o motor grava na planilha.
    match /eap/{id} {
      allow read, write: if ehP3();
    }

    // Atalho de e-mail: o Administrador grava as assinaturas; a P/3 lê e põe pedidos na fila;
    // o motor (Apps Script) envia pelo Gmail e grava o resultado. Pedido com erro: a P/3 só pode pedir de novo.
    match /assinaturas/{id} {
      allow read: if ehP3();
    }

    match /emails/{id} {
      allow read, create: if ehP3();
      allow update: if ehP3()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'erro'])
        && request.resource.data.status == 'pedido';
    }

    function respostaEapValida() {
      let novo = request.resource.data;
      return resource.data.encerrada == false
        && novo.diff(resource.data).affectedKeys()
          .hasOnly(['blocos', 'status', 'respondidoPor', 'respondidoEm', 'gravado', 'atualizadoEm'])
        && novo.status == 'enviada'
        && novo.gravado == false
        && novo.blocos is map
        && novo.respondidoPor is string && novo.respondidoPor.size() > 0;
    }

    match /eapRespostas/{id} {
      allow read: if ehP3() || ehDaMinhaUnidade(resource.data);
      allow create, delete: if ehP3();
      allow update: if ehP3() || (ehDaMinhaUnidade(resource.data) && respostaEapValida());
    }

    // Operações → Controle de Operações (o motor também traz as linhas da aba Operações da planilha antiga).
    // Não se apaga: a exclusão só marca "excluida".
    match /controleOperacoes/{id} {
      allow read, create, update: if ehP3();
    }

    // Pedido do Relatório de Indicadores: a P/3 pede; o motor gera o Word e grava o link.
    function pedidoRelatorioValido() {
      let r = request.resource.data;
      return r.keys().hasOnly(['mes', 'numero', 'status', 'pedidoEm'])
        && r.mes is string && r.mes.matches('^[0-9]{4}-[0-9]{2}$')
        && r.numero is string && r.numero.size() > 0 && r.numero.size() <= 40
        && r.status == 'pedido'
        && r.pedidoEm == request.time;
    }

    match /relatorios/{id} {
      allow read: if ehP3();
      allow create: if ehP3() && pedidoRelatorioValido();
    }

    // Operações → Documentos Mensais.
    // Envio da Cia (id = documento_mês_unidade): só a dela; o motor grava na planilha e marca "gravado".
    function envioMensalValido(id) {
      let r = request.resource.data;
      return r.keys().hasOnly(['docId', 'mesRef', 'unidadeId', 'valores', 'respondidoPor', 'enviadoEm', 'gravado', 'gravadoEm', 'erro', 'erroEm'])
        && r.docId is string && r.mesRef is string && r.mesRef.matches('^[0-9]{4}-[0-9]{2}$')
        && id == r.docId + '_' + r.mesRef + '_' + r.unidadeId
        && r.valores is map && r.valores.size() <= 200
        && r.respondidoPor is string && r.respondidoPor.size() > 0 && r.respondidoPor.size() <= 120
        && r.gravado == false
        && r.enviadoEm == request.time;
    }

    match /docsMensais/{id} {
      allow read: if ehP3() || ehDaMinhaUnidade(resource.data);
      allow create: if ehDaMinhaUnidade(request.resource.data) && envioMensalValido(id);
      allow update: if ehDaMinhaUnidade(resource.data) && ehDaMinhaUnidade(request.resource.data) && envioMensalValido(id);
    }

    // Estado de cada planilha (o motor grava); a P/3 só pede o arquivo e marca "feito".
    match /estadoDocsMensais/{docId} {
      allow read: if ehP3();
      allow create: if ehP3() && request.resource.data.keys().hasOnly(['pedidoArquivar', 'feitos']);
      allow update: if ehP3() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pedidoArquivar', 'feitos']);
    }

    // Configuração que o motor lê (publicada pelo portal da P/3).
    // config/listas (opções do numerador) a P/3 só lê: quem muda é o Administrador.
    match /config/{id} {
      allow read: if ehP3();
      allow write: if ehP3() && id != 'listas';
    }

    // Arquivos (PDF) guardados em partes: a P/3 envia; a P/3 e as Cias baixam. Não se altera depois de enviado;
    // a P/3 apaga (PDF de demanda pendente some quando a demanda é finalizada ou excluída).
    match /arquivos/{id} {
      allow read: if ehP3() || ehPerfil('unidade');
      allow delete: if ehP3();
      allow create: if ehP3()
        && request.resource.data.keys().hasOnly(['nome', 'tipo', 'tamanho', 'partes', 'criadoEm'])
        && request.resource.data.tipo == 'application/pdf'
        && request.resource.data.tamanho is int && request.resource.data.tamanho <= 10485760
        && request.resource.data.partes is int && request.resource.data.partes > 0 && request.resource.data.partes <= 20;
      match /partes/{n} {
        allow read: if ehP3() || ehPerfil('unidade');
        allow create: if ehP3() && request.resource.data.keys().hasOnly(['dados']) && request.resource.data.dados is string;
        allow delete: if ehP3();
      }
    }

    // Aperfeiçoamento → ICC: a P/3 cria e encerra; as Cias veem só as abertas.
    match /iccs/{id} {
      allow read: if ehP3() || (ehPerfil('unidade') && resource.data.status == 'aberta');
      allow create: if ehP3()
        && request.resource.data.keys().hasOnly(['numero', 'prazo', 'status', 'arquivo', 'planilha', 'criadoEm'])
        && request.resource.data.status == 'aberta' && request.resource.data.planilha.status == 'pedida';
      allow update: if ehP3() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prazo', 'status']);
    }

    // Resposta da Cia (id = icc_unidade): só a dela, só com a ICC aberta; o motor grava na planilha.
    function respostaIccValida(id) {
      let r = request.resource.data;
      return r.keys().hasOnly(['iccId', 'unidadeId', 'oficiais', 'sargentos', 'cabos', 'respondidoPor', 'enviadoEm', 'gravado', 'gravadoEm', 'erro', 'erroEm'])
        && id == r.iccId + '_' + r.unidadeId
        && r.oficiais is int && r.oficiais >= 0 && r.sargentos is int && r.sargentos >= 0 && r.cabos is int && r.cabos >= 0
        && r.respondidoPor is string && r.respondidoPor.size() > 0 && r.respondidoPor.size() <= 120
        && r.gravado == false && r.enviadoEm == request.time
        && get(/databases/$(database)/documents/iccs/$(r.iccId)).data.status == 'aberta';
    }

    match /respostasIcc/{id} {
      allow read: if ehP3() || ehDaMinhaUnidade(resource.data);
      allow create: if ehDaMinhaUnidade(request.resource.data) && respostaIccValida(id);
      allow update: if ehDaMinhaUnidade(resource.data) && ehDaMinhaUnidade(request.resource.data) && respostaIccValida(id);
    }

    // Operações → RAC: a P/3 abre o mês de referência com o prazo; as Cias veem só os abertos.
    match /racMeses/{mes} {
      allow read: if ehP3() || (ehPerfil('unidade') && resource.data.status == 'aberto');
      allow create: if ehP3()
        && request.resource.data.keys().hasOnly(['mes', 'prazo', 'status', 'criadoEm'])
        && request.resource.data.mes == mes && mes.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.prazo is string && request.resource.data.status == 'aberto';
      allow update: if ehP3() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prazo', 'status', 'arquivo'])
        && request.resource.data.status in ['aberto', 'encerrado']
        && (!('arquivo' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.status == 'encerrado' && request.resource.data.arquivo.keys().hasOnly(['status', 'nome'])
            && request.resource.data.arquivo.status == 'pedido' && request.resource.data.arquivo.nome is string));
      allow delete: if ehP3();
    }

    // RAC GERAL esperando o motor arquivar no Drive (em partes, como os PDFs). Só a P/3; o motor apaga depois.
    match /racArquivo/{mes} {
      allow read, delete: if ehP3();
      allow create, update: if ehP3()
        && request.resource.data.keys().hasOnly(['mes', 'nome', 'tamanho', 'partes', 'criadoEm'])
        && request.resource.data.mes == mes
        && request.resource.data.tamanho is int && request.resource.data.tamanho <= 41943040
        && request.resource.data.partes is int && request.resource.data.partes > 0 && request.resource.data.partes <= 80;
      match /partes/{n} {
        allow read, delete: if ehP3();
        allow create, update: if ehP3() && request.resource.data.keys().hasOnly(['dados']) && request.resource.data.dados is string;
      }
    }

    // RAC da Cia/FT (id = mes_unidade): só o dela, só com o mês aberto; enviado não volta a rascunho.
    function racValido(id) {
      let r = request.resource.data;
      return r.keys().hasOnly(['mes', 'unidadeId', 'crimes', 'pelotoes', 'producao', 'justificativas', 'status', 'preenchidoPor', 'salvoEm', 'enviadoEm'])
        && id == r.mes + '_' + r.unidadeId
        && r.crimes is map && r.pelotoes is map && r.producao is map && r.justificativas is map
        && r.status in ['rascunho', 'enviado']
        && r.preenchidoPor is string && r.preenchidoPor.size() <= 120
        && (r.status == 'rascunho' || (r.preenchidoPor.size() > 0 && r.enviadoEm == request.time))
        && r.salvoEm == request.time
        && get(/databases/$(database)/documents/racMeses/$(r.mes)).data.status == 'aberto';
    }

    // RAC do Batalhão (id = mes_btl): só a Produtividade RPM, gravada pela P/3 (o resto é a soma das Cias).
    function racBtlValido(id) {
      let r = request.resource.data;
      return r.keys().hasOnly(['mes', 'unidadeId', 'rpm', 'status', 'preenchidoPor', 'salvoEm'])
        && r.unidadeId == 'btl' && id == r.mes + '_btl' && r.rpm is map && r.preenchidoPor is string
        && r.salvoEm == request.time
        && exists(/databases/$(database)/documents/racMeses/$(r.mes));
    }

    match /racs/{id} {
      allow read: if ehP3() || ehDaMinhaUnidade(resource.data);
      allow create: if (ehDaMinhaUnidade(request.resource.data) && racValido(id)) || (ehP3() && racBtlValido(id));
      allow update: if (ehDaMinhaUnidade(resource.data) && ehDaMinhaUnidade(request.resource.data) && racValido(id)
        && !(resource.data.status == 'enviado' && request.resource.data.status == 'rascunho'))
        || (ehP3() && resource.data.unidadeId == 'btl' && racBtlValido(id));
      allow delete: if ehP3();
    }

    // Prints do RAC (id = mes_unidade_slot): a Cia grava/troca os dela com o mês aberto; a P/3 lê.
    function printRacValido(id, campos) {
      let r = request.resource.data;
      return r.keys().hasOnly(campos)
        && r.slot in ['rvPainel', 'rvMapa', 'fvPainel', 'fvMapa', 'roPainel', 'roMapa', 'foPainel']
        && id == r.mes + '_' + r.unidadeId + '_' + r.slot
        && get(/databases/$(database)/documents/racMeses/$(r.mes)).data.status == 'aberto';
    }

    // Prints do Batalhão (só os 4 painéis): a P/3 grava, com o mês existindo (aberto ou encerrado).
    function printBtlValido(id, campos) {
      let r = request.resource.data;
      return ehP3() && r.unidadeId == 'btl' && r.keys().hasOnly(campos)
        && r.slot in ['rvPainel', 'fvPainel', 'roPainel', 'foPainel']
        && id == r.mes + '_btl_' + r.slot
        && exists(/databases/$(database)/documents/racMeses/$(r.mes));
    }

    match /racPrints/{id} {
      allow read: if ehP3() || ehDaMinhaUnidade(resource.data);
      allow create, update: if ((ehDaMinhaUnidade(request.resource.data)
        && (resource == null || ehDaMinhaUnidade(resource.data))
        && printRacValido(id, ['mes', 'unidadeId', 'slot', 'miniatura', 'tamanho', 'enviadoEm']))
        || printBtlValido(id, ['mes', 'unidadeId', 'slot', 'miniatura', 'tamanho', 'enviadoEm']))
        && request.resource.data.miniatura is string && request.resource.data.miniatura.size() <= 60000
        && request.resource.data.enviadoEm == request.time;
      allow delete: if ehP3();
    }

    match /racPrintsDados/{id} {
      allow read: if ehP3() || ehDaMinhaUnidade(resource.data);
      allow create, update: if ((ehDaMinhaUnidade(request.resource.data)
        && (resource == null || ehDaMinhaUnidade(resource.data))
        && printRacValido(id, ['mes', 'unidadeId', 'slot', 'dados']))
        || printBtlValido(id, ['mes', 'unidadeId', 'slot', 'dados']))
        && request.resource.data.dados is string && request.resource.data.dados.size() <= 900000;
      allow delete: if ehP3();
    }

    // Banco de efetivo (busca por RE): copiado da planilha pelo motor.
    // O CFP (e a P/3) cadastram à mão quem não está no banco; o motor leva para a aba BD Efetivo.
    // Só cria: quem já está no banco não é alterado pelo portal.
    function efetivoManualValido(re) {
      let p = request.resource.data;
      return re.matches('^[0-9]{5,6}$')
        && p.keys().hasOnly(['re', 'posto', 'nomeGuerra', 'nomeCompleto', 'telefone', 'manual', 'cadastradoEm'])
        && p.keys().hasAll(['re', 'posto', 'nomeGuerra', 'nomeCompleto', 'manual', 'cadastradoEm'])
        && p.manual == true
        && p.cadastradoEm == request.time
        && p.re is string && p.re.size() >= 5 && p.re.size() <= 12
        && p.posto is string && p.posto.size() > 0 && p.posto.size() <= 30
        && p.nomeGuerra is string && p.nomeGuerra.size() > 0 && p.nomeGuerra.size() <= 40
        && p.nomeCompleto is string && p.nomeCompleto.size() > 0 && p.nomeCompleto.size() <= 120
        && (!p.keys().hasAny(['telefone']) || (p.telefone is string && p.telefone.size() <= 20));
    }

    match /efetivo/{re} {
      allow read: if logado();
      allow create: if (ehPerfil('cfp') || ehP3()) && efetivoManualValido(re);
    }

    // TDS: até 5 fotos por CFP (RE) por mês. O id ({mes}_{re}_{vaga}, vaga 1 a 5) garante o limite;
    // a foto (fotosTdsDados) e o resumo (fotosTds) são gravados juntos. Ninguém altera; só a P/3 apaga.
    function fotoTdsValida(id) {
      let f = request.resource.data;
      return ehPerfil('cfp')
        && f.keys().hasOnly(['mes', 're', 'cfp', 'data', 'assunto', 'vaga', 'miniatura', 'tamanho', 'enviadoEm'])
        && f.keys().hasAll(['mes', 're', 'cfp', 'data', 'assunto', 'vaga', 'miniatura', 'tamanho', 'enviadoEm'])
        && f.mes is string && f.mes.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && f.re is string && f.re.matches('^[0-9]{5,6}$')
        && f.vaga is int && f.vaga >= 1 && f.vaga <= 5
        && id == f.mes + '_' + f.re + '_' + string(f.vaga)
        && f.data is string && f.data.matches(f.mes + '-(0[1-9]|[12][0-9]|3[01])')
        && f.assunto is string && f.assunto.size() > 0 && f.assunto.size() <= 120
        && f.cfp is map && f.cfp.keys().hasOnly(['posto', 'nomeGuerra'])
        && f.cfp.posto is string && f.cfp.posto.size() <= 30
        && f.cfp.nomeGuerra is string && f.cfp.nomeGuerra.size() > 0 && f.cfp.nomeGuerra.size() <= 40
        && f.miniatura is string && f.miniatura.size() > 0 && f.miniatura.size() <= 60000
        && f.tamanho is int && f.tamanho > 0 && f.tamanho <= 900000
        && f.enviadoEm == request.time
        && existsAfter(/databases/$(database)/documents/fotosTdsDados/$(id))
        && getAfter(/databases/$(database)/documents/fotosTdsDados/$(id)).data.dados.size() == f.tamanho;
    }

    // Apagar: a P/3 apaga qualquer foto; o CFP apaga as próprias para trocar ou cancelar (a tela só mostra o RE digitado).
    match /fotosTds/{id} {
      allow read: if ehP3() || ehPerfil('cfp');
      allow create: if fotoTdsValida(id);
      allow delete: if ehP3() || ehPerfil('cfp');
    }

    match /fotosTdsDados/{id} {
      allow read: if ehP3();
      allow delete: if ehP3() || ehPerfil('cfp');
      allow create: if ehPerfil('cfp')
        && request.resource.data.keys().hasOnly(['dados'])
        && request.resource.data.dados is string
        && request.resource.data.dados.size() > 0
        && request.resource.data.dados.size() <= 900000
        && existsAfter(/databases/$(database)/documents/fotosTds/$(id));
    }

    // Missões com pasta do CFP: gravadas pelo motor, lidas pelo CFP.
    // Recado do Cmt do P3 (CFP e Sala de Operações): a P/3 escreve e apaga; o setor só lê.
    function recadoValido() {
      let novo = request.resource.data;
      return ehP3()
        && novo.keys().hasOnly(['texto', 'criadoEm'])
        && novo.texto is string
        && novo.texto.size() > 0
        && novo.texto.size() <= 2000
        && novo.criadoEm == request.time;
    }

    match /recadosCfp/{recadoId} {
      allow read: if ehP3() || ehPerfil('cfp');
      allow create: if recadoValido();
      allow delete: if ehP3();
    }

    // Acessos individuais (id = RE sem dígito): só o Administrador cadastra; o motor cria as contas.
    // (A regra geral do Administrador, no topo, já libera leitura e gravação.)

    match /recadosSala/{recadoId} {
      allow read: if ehP3() || veSala();
      allow create: if recadoValido();
      allow delete: if ehP3();
    }

    // Agenda da P/3 no portal (eventos próprios; as datas do Numerador vêm das demandas).
    function compromissoValido() {
      let d = request.resource.data;
      let dataISO = '^[0-9]{4}-[0-9]{2}-[0-9]{2}$';
      return d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 200
        && d.data is string && d.data.matches(dataISO)
        && d.dataFim is string && d.dataFim.matches(dataISO) && d.dataFim >= d.data
        && d.fimSerie is string && d.fimSerie >= d.data
        && d.diaInteiro is bool
        && d.repeticao in ['nao', 'diaria', 'semanal', 'mensal', 'anual']
        && d.descricao is string && d.descricao.size() <= 5000
        && d.excecoes is list && d.excecoes.size() <= 500
        && d.criadoPor is string && d.criadoPor.size() > 0;
    }

    match /agenda/{compromissoId} {
      allow read, delete: if ehP3();
      allow create: if ehP3() && compromissoValido();
      allow update: if ehP3() && compromissoValido() && request.resource.data.criadoPor == resource.data.criadoPor;
    }

    // Agenda de cada Cia/FT e da Sala de Operações: cada uma só vê e mexe na sua (a P/3 não entra).
    function ehDonoDaAgenda(dono) {
      return logado() && dono is string
        && ((request.auth.token.perfil == 'unidade' && request.auth.token.get('unidade', '') == dono)
          || (request.auth.token.perfil == 'sala' && dono == 'sala'));
    }

    match /agendaSetores/{compromissoId} {
      allow read, delete: if ehDonoDaAgenda(resource.data.dono);
      allow create: if ehDonoDaAgenda(request.resource.data.dono) && compromissoValido();
      allow update: if ehDonoDaAgenda(resource.data.dono) && compromissoValido()
        && request.resource.data.dono == resource.data.dono
        && request.resource.data.criadoPor == resource.data.criadoPor;
    }

    // Numerador de cada Cia/FT: independente (não distribui). Cada Cia só vê e mexe nas suas demandas.
    function ehDaCia(unidade) {
      return logado() && request.auth.token.perfil == 'unidade'
        && request.auth.token.get('unidade', '') == unidade;
    }

    function demandaCiaValida() {
      let d = request.resource.data;
      return d.saida is string && d.saida.size() > 0 && d.saida.size() <= 200
        && d.tipoSaida is string && d.tipoSaida.size() > 0
        && d.dataEntrada is string && d.dataEntrada.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.prazo is string && d.observacao is string && d.observacao.size() <= 5000
        && d.status in ['em_aberto', 'concluida'];
    }

    match /demandasCia/{demandaId} {
      allow read, delete: if ehDaCia(resource.data.unidadeId);
      // O número tem que ser o que o contador da Cia acabou de dar (na mesma gravação).
      allow create: if ehDaCia(request.resource.data.unidadeId) && demandaCiaValida()
        && request.resource.data.status == 'em_aberto'
        && request.resource.data.contadorId.split('_')[0] == request.resource.data.unidadeId
        && demandaId == request.resource.data.contadorId + '_' + string(request.resource.data.sequencia)
        && getAfter(/databases/$(database)/documents/contadoresCia/$(request.resource.data.contadorId)).data.ultimo
          == request.resource.data.sequencia;
      // O número, o tipo, a Cia e a data de entrada não mudam.
      allow update: if ehDaCia(resource.data.unidadeId) && demandaCiaValida()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['saida', 'origem', 'numeroOrigem', 'prazo', 'responsavel', 'observacao', 'status', 'agendaId', 'atualizadoPor', 'atualizadoEm']);
    }

    // CGP de cada Cia/FT: a Cia administra; o CGP (acesso por RE, perfil 'cgp' + unidade) entra só na página dele.
    // Uma Cia (e o CGP dela) não vê o CGP da outra.
    function ehCgpDa(unidade) {
      return logado() && request.auth.token.perfil == 'cgp'
        && request.auth.token.get('unidade', '') == unidade;
    }
    function veCgp(unidade) {
      return ehDaCia(unidade) || ehCgpDa(unidade);
    }
    // Missão: id fixo "{cia}_{origem}_{ref}" -> a mesma demanda não vai duas vezes (não há update).
    match /cgpMissoes/{missaoId} {
      allow get: if veCgp(missaoId.split('_')[0]);
      allow list: if veCgp(resource.data.unidadeId);
      allow delete: if ehDaCia(resource.data.unidadeId);
      allow create: if ehDaCia(request.resource.data.unidadeId)
        && missaoId == request.resource.data.unidadeId + '_' + request.resource.data.origem + '_' + request.resource.data.refId
        && request.resource.data.origem in ['enc', 'numerador']
        && request.resource.data.inicio is string && request.resource.data.inicio.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.fim is string && request.resource.data.fim.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.fim >= request.resource.data.inicio
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 300
        && request.resource.data.criadoPor is string && request.resource.data.criadoPor.size() > 0;
    }

    match /recadosCgp/{id} {
      allow read: if veCgp(resource.data.unidadeId);
      allow delete: if ehDaCia(resource.data.unidadeId);
      allow create: if ehDaCia(request.resource.data.unidadeId)
        && request.resource.data.keys().hasOnly(['unidadeId', 'texto', 'criadoPor', 'criadoEm'])
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 2000;
    }

    // Fotos do CGP: sem limite de quantidade; descrição, local e observação obrigatórios; quem e quando ficam gravados.
    function fotoCgpValida(id) {
      let f = request.resource.data;
      return veCgp(f.unidadeId)
        && f.keys().hasOnly(['unidadeId', 'descricao', 'local', 'observacao', 'miniatura', 'tamanho', 'enviadoPor', 'enviadoEm'])
        && f.descricao is string && f.descricao.size() > 0 && f.descricao.size() <= 300
        && f.local is string && f.local.size() > 0 && f.local.size() <= 300
        && f.observacao is string && f.observacao.size() > 0 && f.observacao.size() <= 300
        && f.enviadoPor is string && f.enviadoPor.size() > 0
        && f.enviadoEm == request.time
        && f.miniatura is string && f.miniatura.size() <= 60000
        && getAfter(/databases/$(database)/documents/fotosCgpDados/$(id)).data.dados.size() == f.tamanho;
    }

    match /fotosCgp/{id} {
      allow read, delete: if veCgp(resource.data.unidadeId);
      allow create: if fotoCgpValida(id);
    }

    match /fotosCgpDados/{id} {
      allow read, delete: if veCgp(resource.data.unidadeId);
      allow create: if veCgp(request.resource.data.unidadeId)
        && request.resource.data.keys().hasOnly(['unidadeId', 'dados'])
        && request.resource.data.dados is string && request.resource.data.dados.size() > 0
        && request.resource.data.dados.size() <= 900000
        && existsAfter(/databases/$(database)/documents/fotosCgp/$(id));
    }

    // Contador de cada Cia/tipo/ano: só avança de 1 em 1 (começar de outro número é pelo Administrador).
    match /contadoresCia/{contadorId} {
      allow read: if ehDaCia(contadorId.split('_')[0]);
      allow create: if ehDaCia(request.resource.data.unidadeId) && contadorId.split('_')[0] == request.resource.data.unidadeId
        && request.resource.data.keys().hasOnly(['ultimo', 'unidadeId']) && request.resource.data.ultimo == 1;
      allow update: if ehDaCia(resource.data.unidadeId)
        && request.resource.data.unidadeId == resource.data.unidadeId
        && request.resource.data.keys().hasOnly(['ultimo', 'unidadeId'])
        && request.resource.data.ultimo == resource.data.ultimo + 1;
    }

    // Cópia da agenda do CFP (gravada só pelo Apps Script).
    match /agendaCfp/{docId} {
      allow read: if ehP3() || ehPerfil('cfp');
    }

    match /caixaEntrada/{itemId} {
      allow read, write: if ehP3();
    }

    // A P/3 só avança o contador de 1 em 1, ao cadastrar (o geral e o de cada tipo de saída por ano).
    // Começar de outro número ou voltar o número é só pelo Administrador.
    match /contadores/{contadorId} {
      allow read: if ehP3();
      allow create: if ehP3() && request.resource.data.keys().hasOnly(['ultimo']) && request.resource.data.ultimo == 1;
      allow update: if ehP3() && request.resource.data.keys().hasOnly(['ultimo'])
        && request.resource.data.ultimo == resource.data.ultimo + 1;
    }
  }
}
